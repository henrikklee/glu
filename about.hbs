<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>glu third-party licenses</title>
  <style>
    body { font: 16px/1.5 system-ui, sans-serif; margin: 0; color: #202124; }
    main { max-width: 900px; margin: 0 auto; padding: 2rem; }
    pre { padding: 1rem; overflow: auto; white-space: pre-wrap; background: #f5f5f5; }
    .license-used-by { margin-top: -.5rem; }
    @media (prefers-color-scheme: dark) {
      body { color: #eee; background: #202124; }
      a { color: #8ab4f8; }
      pre { background: #303134; }
    }
  </style>
</head>
<body>
<main>
  <h1>glu third-party licenses</h1>
  <p>This report covers the locked normal dependencies of the aarch64 macOS release. Build-only and test-only dependencies are excluded.</p>

  <h2>License overview</h2>
  <ul>
    {{#each overview}}
    <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
    {{/each}}
  </ul>

  <h2>License texts</h2>
  {{#each licenses}}
    {{#if first_of_kind}}<h3 id="{{id}}">{{name}}</h3>{{/if}}
    <h4 id="{{id}}-{{@index}}">{{name}}</h4>
    <p>Used by:</p>
    <ul class="license-used-by">
      {{#each used_by}}
      <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
      {{/each}}
    </ul>
    <pre>{{text}}</pre>
  {{/each}}
</main>
</body>
</html>
